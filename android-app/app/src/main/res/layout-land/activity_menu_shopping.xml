<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/rootShopping"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <RelativeLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.9">

      <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/actionBar"
        android:layout_alignParentTop="true"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingBottom="12dp">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Ourmeal.Button.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back_to_menu"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/muted" />

          <TextView
            style="@style/TextAppearance.Ourmeal.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/menu_shopping_kicker" />

          <TextView
            style="@style/TextAppearance.Ourmeal.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityHeading="true"
            android:text="@string/menu_shopping_title" />

          <TextView
            android:id="@+id/tvWeekRange"
            style="@style/TextAppearance.Ourmeal.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

          <include
            android:id="@+id/destinationSection"
            layout="@layout/view_shopping_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />
        </LinearLayout>
      </ScrollView>

      <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
          android:id="@+id/tvShoppingSummary"
          style="@style/TextAppearance.Ourmeal.Muted"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:accessibilityLiveRegion="polite" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnConfirmShopping"
          style="@style/Widget.Ourmeal.Button.Primary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:maxLines="2"
          android:minHeight="56dp"
          app:icon="@drawable/ic_plus" />
      </LinearLayout>
    </RelativeLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="32dp"
      android:layout_weight="1.1">

      <LinearLayout
        android:id="@+id/dishesSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            style="@style/TextAppearance.Ourmeal.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/menu_shopping_dishes_title" />

          <TextView
            android:id="@+id/tvDishCount"
            style="@style/TextAppearance.Ourmeal.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sage" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
          android:id="@+id/shoppingScroll"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:clipToPadding="false"
          android:fillViewport="true"
          android:scrollbars="none">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
              android:id="@+id/tvMemoryUnavailable"
              style="@style/TextAppearance.Ourmeal.Meta"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp"
              android:text="@string/menu_shopping_memory_unavailable"
              android:visibility="gone" />

            <LinearLayout
              android:id="@+id/layoutDishes"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical" />
          </LinearLayout>
        </androidx.core.widget.NestedScrollView>
      </LinearLayout>

      <include
        android:id="@+id/loadingPanel"
        layout="@layout/view_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

      <include
        android:id="@+id/statePanel"
        layout="@layout/view_state_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
