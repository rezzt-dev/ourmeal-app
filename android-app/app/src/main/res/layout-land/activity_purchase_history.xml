<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/rootPurchases"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="12dp">

    <ScrollView
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.85"
      android:fillViewport="true"
      android:paddingBottom="16dp"
      android:clipToPadding="false"
      android:scrollbars="none">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnBackToLists"
          style="@style/Widget.Ourmeal.Button.Text.Muted"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:text="@string/back_to_lists"
          app:icon="@drawable/ic_arrow_back"
          app:iconTint="@color/muted" />

        <TextView
          style="@style/TextAppearance.Ourmeal.Label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/purchases_kicker" />

        <TextView
          style="@style/TextAppearance.Ourmeal.Headline"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:accessibilityHeading="true"
          android:text="@string/purchases_title_first" />

        <TextView
          style="@style/TextAppearance.Ourmeal.Headline.Accent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/purchases_title_second" />

        <TextView
          style="@style/TextAppearance.Ourmeal.Muted"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/purchases_intro" />
      </LinearLayout>
    </ScrollView>

    <RelativeLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1.15"
      android:layout_marginStart="32dp">

      <LinearLayout
        android:id="@+id/purchasesSectionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          style="@style/TextAppearance.Ourmeal.SectionTitle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginEnd="12dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/purchases_section_title" />

        <TextView
          android:id="@+id/tvPurchaseCount"
          style="@style/TextAppearance.Ourmeal.Label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/sage" />
      </LinearLayout>

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/purchasesSectionRow"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recyclerViewPurchases"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:paddingBottom="16dp"
          android:scrollbars="none" />

        <include
          android:id="@+id/loadingPanel"
          layout="@layout/view_loading"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="gone" />

        <include
          android:id="@+id/statePanel"
          layout="@layout/view_state_panel"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="gone" />
      </FrameLayout>
    </RelativeLayout>
  </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
