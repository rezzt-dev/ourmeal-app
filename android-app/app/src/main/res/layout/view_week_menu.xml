<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/menuBoard"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:focusableInTouchMode="true"
  android:visibility="gone">

  <HorizontalScrollView
    android:id="@+id/daySelectorScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="horizontal"
    android:scrollbarStyle="outsideOverlay"
    android:paddingBottom="8dp">

    <LinearLayout
      android:id="@+id/layoutDaySelector"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal" />
  </HorizontalScrollView>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_menu_editor"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/tvSelectedDay"
        style="@style/TextAppearance.Ourmeal.SectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:accessibilityLiveRegion="polite" />
      <TextView
        android:id="@+id/tvSelectedTodayBadge"
        style="@style/TextAppearance.Ourmeal.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/day_today"
        android:visibility="gone" />
    </LinearLayout>
    <TextView
      android:id="@+id/tvSelectedDate"
      style="@style/TextAppearance.Ourmeal.Meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="@color/sage" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="16dp"
      android:layout_marginBottom="12dp"
      android:background="@color/outline"
      android:importantForAccessibility="no" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        style="@style/TextAppearance.Ourmeal.Meta.Strong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:labelFor="@id/etComida"
        android:text="@string/day_lunch" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatEditText
      android:id="@+id/etComida"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:background="@drawable/bg_menu_field"
      android:drawableEnd="@drawable/ic_edit_meal"
      android:drawablePadding="12dp"
      android:backgroundTint="@null"
      android:hint="@string/day_lunch_placeholder"
      android:fontFamily="@font/source_sans_3"
      android:textColor="@color/ink"
      android:textColorHint="@color/muted"
      android:gravity="center_vertical|start"
      android:imeOptions="actionNext|flagNoExtractUi"
      android:importantForAutofill="no"
      android:inputType="textCapSentences|textMultiLine"
      android:maxLength="120"
      android:minHeight="48dp"
      android:paddingHorizontal="12dp"
      android:paddingVertical="12dp"
      android:textSize="@dimen/type_body_large" />
    <!-- Chips keep a 48dp touch target, so their own inset gives the 8dp gap below the field. -->
    <HorizontalScrollView
      android:id="@+id/comidaSuggestionsScroll"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:importantForAccessibility="no"
      android:scrollbars="none"
      android:visibility="gone">
      <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsComidaSuggestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:singleLine="true" />
    </HorizontalScrollView>
    <TextView
      android:id="@+id/tvComidaRepeat"
      style="@style/TextAppearance.Ourmeal.Meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:accessibilityLiveRegion="polite"
      android:textColor="@color/sage"
      android:visibility="gone" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="16dp"
      android:layout_marginBottom="12dp"
      android:background="@color/outline"
      android:importantForAccessibility="no" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        style="@style/TextAppearance.Ourmeal.Meta.Strong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:labelFor="@id/etCena"
        android:text="@string/day_dinner" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatEditText
      android:id="@+id/etCena"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:background="@drawable/bg_menu_field"
      android:drawableEnd="@drawable/ic_edit_meal"
      android:drawablePadding="12dp"
      android:backgroundTint="@null"
      android:hint="@string/day_dinner_placeholder"
      android:fontFamily="@font/source_sans_3"
      android:textColor="@color/ink"
      android:textColorHint="@color/muted"
      android:gravity="center_vertical|start"
      android:imeOptions="actionDone|flagNoExtractUi"
      android:importantForAutofill="no"
      android:inputType="textCapSentences|textMultiLine"
      android:maxLength="120"
      android:minHeight="48dp"
      android:paddingHorizontal="12dp"
      android:paddingVertical="12dp"
      android:textSize="@dimen/type_body_large" />
    <!-- Chips keep a 48dp touch target, so their own inset gives the 8dp gap below the field. -->
    <HorizontalScrollView
      android:id="@+id/cenaSuggestionsScroll"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:importantForAccessibility="no"
      android:scrollbars="none"
      android:visibility="gone">
      <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsCenaSuggestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:singleLine="true" />
    </HorizontalScrollView>
    <TextView
      android:id="@+id/tvCenaRepeat"
      style="@style/TextAppearance.Ourmeal.Meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:accessibilityLiveRegion="polite"
      android:textColor="@color/sage"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
