<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/menuBoard"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_surface"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="16dp"
  android:paddingEnd="12dp"
  android:paddingBottom="16dp"
  android:visibility="gone">

  <HorizontalScrollView
    android:id="@+id/daySelectorScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:requiresFadingEdge="horizontal"
    android:fadingEdgeLength="12dp"
    android:scrollbars="none">

    <LinearLayout
      android:id="@+id/layoutDaySelector"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="horizontal" />
  </HorizontalScrollView>

  <TextView
    android:id="@+id/tvSelectedDay"
    style="@style/TextAppearance.Ourmeal.SectionTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:accessibilityHeading="true"
    android:accessibilityLiveRegion="polite"
    android:textSize="24sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/tvSelectedDate"
      style="@style/TextAppearance.Ourmeal.Meta"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textColor="@color/sage" />

    <TextView
      android:id="@+id/tvSelectedTodayBadge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/source_sans_3_semibold"
      android:letterSpacing="0.08"
      android:text="@string/day_today"
      android:textAllCaps="true"
      android:textColor="@color/brand"
      android:textSize="12sp"
      android:visibility="gone" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="56dp"
      android:orientation="horizontal">

      <TextView
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans_3_semibold"
        android:labelFor="@id/etComida"
        android:letterSpacing="0.08"
        android:text="@string/day_lunch"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="12sp" />

      <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etComida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_meal_line"
        android:fontFamily="@font/source_sans_3"
        android:hint="@string/day_lunch_placeholder"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="120"
        android:maxLines="2"
        android:minHeight="48dp"
        android:paddingStart="0dp"
        android:paddingTop="12dp"
        android:paddingEnd="0dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:minHeight="56dp"
      android:orientation="horizontal">

      <TextView
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans_3_semibold"
        android:labelFor="@id/etCena"
        android:letterSpacing="0.08"
        android:text="@string/day_dinner"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="12sp" />

      <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCena"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_meal_line"
        android:fontFamily="@font/source_sans_3"
        android:hint="@string/day_dinner_placeholder"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="120"
        android:maxLines="2"
        android:minHeight="48dp"
        android:paddingStart="0dp"
        android:paddingTop="12dp"
        android:paddingEnd="0dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="17sp" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    style="@style/TextAppearance.Ourmeal.Meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:text="@string/menu_footnote" />
</LinearLayout>
