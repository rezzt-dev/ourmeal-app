<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="8dp"
  app:cardBackgroundColor="@color/surface"
  app:cardCornerRadius="10dp"
  app:cardElevation="0dp"
  app:strokeColor="@color/hairline"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/dishHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:importantForAccessibility="no"
      android:minHeight="72dp"
      android:orientation="horizontal"
      android:paddingStart="6dp"
      android:paddingTop="8dp"
      android:paddingEnd="16dp"
      android:paddingBottom="8dp">

      <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbIncludeDish"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:checked="true"
        android:padding="12dp"
        app:buttonTint="@color/checkbox_tint" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvDishName"
          style="@style/TextAppearance.Ourmeal.Body.Strong"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/ink" />

        <TextView
          android:id="@+id/tvDishOccurrences"
          style="@style/TextAppearance.Ourmeal.Meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/dishBody"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="60dp"
      android:paddingEnd="16dp"
      android:paddingBottom="16dp">

      <TextView
        android:id="@+id/tvRememberedBadge"
        style="@style/TextAppearance.Ourmeal.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_shopping_remembered"
        android:textColor="@color/sage"
        android:visibility="gone" />

      <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="0dp" />

      <TextView
        android:id="@+id/tvNoIngredients"
        style="@style/TextAppearance.Ourmeal.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_shopping_no_ingredients"
        android:visibility="gone" />

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ingredientField"
        style="@style/Widget.Ourmeal.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/menu_shopping_ingredient_hint"
        app:endIconDrawable="@drawable/ic_plus"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etIngredient"
          style="@style/Widget.Ourmeal.TextInputEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionDone|flagNoExtractUi"
          android:importantForAutofill="no"
          android:inputType="textCapSentences"
          android:maxLength="80"
          android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
