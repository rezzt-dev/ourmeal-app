<?xml version="1.0" encoding="utf-8"?>
<!-- One supermarket in the price detail. Read as a single sentence by screen readers. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="6dp"
  android:focusable="true"
  android:orientation="vertical"
  android:paddingHorizontal="12dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/tvOfferChain"
      style="@style/TextAppearance.Ourmeal.Body.Strong"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/tvOfferUnitPrice"
      style="@style/TextAppearance.Ourmeal.Body.Strong"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:fontFeatureSettings="tnum" />
  </LinearLayout>

  <TextView
    android:id="@+id/tvOfferBest"
    style="@style/TextAppearance.Ourmeal.Label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="@string/prices_detail_best"
    android:textColor="@color/sage"
    android:visibility="gone" />

  <TextView
    android:id="@+id/tvOfferProduct"
    style="@style/TextAppearance.Ourmeal.Meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="@color/ink"
    android:visibility="gone" />

  <TextView
    android:id="@+id/tvOfferMeta"
    style="@style/TextAppearance.Ourmeal.Meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp" />
</LinearLayout>
