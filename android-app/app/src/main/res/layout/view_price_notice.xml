<?xml version="1.0" encoding="utf-8"?>
<!-- One line about the price comparison of the list: where it compares, or what it needs. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:minHeight="48dp"
  android:orientation="horizontal">

  <TextView
    android:id="@+id/tvPriceNotice"
    style="@style/TextAppearance.Ourmeal.Meta"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:accessibilityLiveRegion="polite" />

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnPriceSettings"
    style="@style/Widget.Ourmeal.Button.Text"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginStart="12dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:text="@string/prices_setup" />
</LinearLayout>
