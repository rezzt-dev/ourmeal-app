<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:clipToPadding="false"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/cityField"
      style="@style/Widget.Ourmeal.TextInputLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/city_search_label"
      app:endIconMode="clear_text"
      app:placeholderText="@string/city_search_example"
      app:startIconDrawable="@drawable/ic_search"
      app:startIconTint="@color/muted">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etCity"
        style="@style/Widget.Ourmeal.TextInputEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textCapWords|textNoSuggestions"
        android:maxLength="60"
        android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
      android:id="@+id/tvCitySearchStatus"
      style="@style/TextAppearance.Ourmeal.Meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:accessibilityLiveRegion="polite"
      android:text="@string/city_search_hint" />

    <LinearLayout
      android:id="@+id/cityResults"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:orientation="vertical" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
