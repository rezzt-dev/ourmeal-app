<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="wrap_content"
  android:minWidth="48dp"
  android:layout_height="wrap_content"
  android:minHeight="64dp"
  android:paddingHorizontal="6dp"
  android:paddingTop="8dp"
  android:paddingBottom="8dp"
  android:background="@drawable/bg_day_chip_normal"
  android:clickable="true"
  android:focusable="true"
  android:foreground="@drawable/ripple_day_chip"
  android:gravity="center"
  android:importantForAccessibility="yes"
  android:orientation="vertical">

  <TextView
    android:id="@+id/tvChipDay"
    style="@style/TextAppearance.Ourmeal.Caption"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:textColor="@color/ink" />

  <TextView
    android:id="@+id/tvChipDate"
    style="@style/TextAppearance.Ourmeal.Stat"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:importantForAccessibility="no"
    android:textColor="@color/muted" />
</LinearLayout>
