<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="10dp"
  android:clickable="true"
  android:focusable="true"
  app:cardBackgroundColor="@color/cream"
  app:cardCornerRadius="12dp"
  app:cardElevation="0dp"
  app:rippleColor="@color/ripple_dark"
  app:strokeWidth="0dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <TextView
        android:id="@+id/tvListName"
        style="@style/TextAppearance.Ourmeal.CardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2" />

      <ImageButton
        android:id="@+id/btnDeleteList"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_list_generic"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/cream_muted" />
    </LinearLayout>

    <TextView
      android:id="@+id/tvCreatedDate"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:fontFamily="@font/source_sans_3"
      android:textColor="@color/cream_muted"
      android:textSize="13sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <TextView
        android:id="@+id/tvItemCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/source_sans_3_semibold"
        android:textColor="@color/cream_deep"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans_3_semibold"
        android:textColor="@color/cream_deep"
        android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
      android:id="@+id/progressCompletion"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="5dp"
      android:layout_marginTop="10dp"
      android:max="100"
      android:progressBackgroundTint="@color/cream_track"
      android:progressTint="@color/cream_deep" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      app:drawableEndCompat="@drawable/ic_arrow_forward"
      android:drawablePadding="6dp"
      app:drawableTint="@color/cream_deep"
      android:fontFamily="@font/source_sans_3_semibold"
      android:text="@string/list_open"
      android:textColor="@color/cream_deep"
      android:textSize="14sp" />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
