<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/rootMain"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ScrollView
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">

          <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/bricolage_grotesque"
            android:letterSpacing="0.01"
            android:text="@string/home_wordmark"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

          <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenLists"
            style="@style/Widget.Ourmeal.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="@string/open_lists"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconSize="16dp" />
        </LinearLayout>

        <TextView
          style="@style/TextAppearance.Ourmeal.Display"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="18dp"
          android:text="@string/home_title_first"
          android:accessibilityHeading="true" />

        <TextView
          style="@style/TextAppearance.Ourmeal.Display.Accent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/home_title_second" />

        <TextView
          style="@style/TextAppearance.Ourmeal.Muted"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/home_intro"
          android:textSize="16sp" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="22dp"
          android:background="@drawable/bg_sage"
          android:orientation="vertical"
          android:padding="20dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:fontFamily="@font/source_sans_3_semibold"
              android:text="@string/week_label"
              android:textColor="@color/cream_deep"
              android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnToday"
              style="@style/Widget.Ourmeal.Button.Text.OnSage"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:minWidth="0dp"
              android:minHeight="48dp"
              android:text="@string/week_today_action"
              android:textSize="13sp"
              android:visibility="gone"
              app:icon="@drawable/ic_refresh"
              app:iconSize="15dp" />
          </LinearLayout>

          <TextView
            android:id="@+id/tvWeekTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/bricolage_grotesque"
            android:letterSpacing="-0.01"
            android:textColor="@color/dark_ink"
            android:textSize="23sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvWeekProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/source_sans_3"
            android:textColor="@color/cream_muted"
            android:textSize="14sp" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
              android:id="@+id/btnPreviousWeek"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:background="@drawable/bg_cream"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/week_previous"
              android:padding="14dp"
              android:src="@drawable/ic_chevron_left" />

            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnOpenCalendar"
              android:contentDescription="@string/open_calendar"
              style="@style/Widget.Ourmeal.Button.Cream"
              android:layout_width="0dp"
              android:layout_height="48dp"
              android:layout_marginStart="8dp"
              android:layout_marginEnd="8dp"
              android:layout_weight="1"
              android:paddingStart="10dp"
              android:paddingEnd="10dp"
              android:text="@string/week_pick_date"
              android:textSize="14sp"
              app:icon="@drawable/ic_calendar"
              app:iconGravity="textStart" />

            <ImageButton
              android:id="@+id/btnNextWeek"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:background="@drawable/bg_cream"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/week_next"
              android:padding="14dp"
              android:src="@drawable/ic_chevron_right" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="14dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

          <TextView
            style="@style/TextAppearance.Ourmeal.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_section_title" />

          <TextView
            style="@style/TextAppearance.Ourmeal.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/week_days"
            android:textColor="@color/sage" />
        </LinearLayout>

        <include
          android:id="@+id/menuLoading"
          layout="@layout/view_loading"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:visibility="gone" />

        <include
          android:id="@+id/menuError"
          layout="@layout/view_state_panel"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:visibility="gone" />

        <include
          android:id="@+id/menuBoard"
          layout="@layout/view_week_menu"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

          <View
            android:id="@+id/viewSaveDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot" />

          <TextView
            android:id="@+id/tvSaveStatus"
            style="@style/TextAppearance.Ourmeal.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/save_idle" />
        </LinearLayout>
      </LinearLayout>
  </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
