<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:clipToPadding="false"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <TextView
      android:id="@+id/tvPriceSubtitle"
      style="@style/TextAppearance.Ourmeal.Muted"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />

    <TextView
      android:id="@+id/tvPriceSaving"
      style="@style/TextAppearance.Ourmeal.Body.Strong"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:textColor="@color/sage"
      android:visibility="gone" />

    <TextView
      android:id="@+id/tvPriceTrap"
      style="@style/TextAppearance.Ourmeal.Body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="@color/brand"
      android:visibility="gone" />

    <TextView
      android:id="@+id/tvPriceOld"
      style="@style/TextAppearance.Ourmeal.Body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="@color/muted"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/offersContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/tvPriceNote"
      style="@style/TextAppearance.Ourmeal.Caption"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/prices_detail_note" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
