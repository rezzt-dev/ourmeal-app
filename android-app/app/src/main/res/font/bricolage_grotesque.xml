<?xml version="1.0" encoding="utf-8"?>
<!-- títulos: bricolage grotesque variable con tamaño óptico de texto mediano (20-24sp). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
  <font
    android:font="@font/bricolage_grotesque_variable"
    android:fontStyle="normal"
    android:fontWeight="600"
    android:fontVariationSettings="'opsz' 28, 'wdth' 100, 'wght' 600" />
  <font
    android:font="@font/bricolage_grotesque_variable"
    android:fontStyle="normal"
    android:fontWeight="700"
    android:fontVariationSettings="'opsz' 28, 'wdth' 100, 'wght' 700" />
  <font
    android:font="@font/bricolage_grotesque_variable"
    android:fontStyle="normal"
    android:fontWeight="800"
    android:fontVariationSettings="'opsz' 28, 'wdth' 100, 'wght' 800" />
</font-family>
