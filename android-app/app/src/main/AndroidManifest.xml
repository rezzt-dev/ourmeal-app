<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Price comparison only: the city name and product names go to the price service. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Approximate location, asked on demand, only to name the user's city. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <application
    android:name="ourmeal.app.OurmealApplication"
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Ourmeal">
    <activity
      android:name="ourmeal.app.SettingsActivity"
      android:exported="false"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name="ourmeal.app.ListDetailActivity"
      android:exported="false"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name="ourmeal.app.MenuShoppingActivity"
      android:exported="false"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name="ourmeal.app.ListActivity"
      android:exported="false"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name="ourmeal.app.MainActivity"
      android:exported="true"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>

</manifest>
