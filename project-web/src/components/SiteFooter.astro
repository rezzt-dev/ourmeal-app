---
import { UtensilsCrossed } from "@lucide/astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-about">
      <a class="brand" href="/" aria-label="OurMeal, ir al inicio">
        <span class="brand-mark">
          <UtensilsCrossed size={18} aria-hidden="true" />
        </span>
        OurMeal
      </a>
      <p>Planifica tus comidas. Organiza tus compras.</p>
    </div>
    <nav class="footer-links" aria-label="Enlaces del pie de página">
      <div>
        <h2>Explora</h2>
        <a href="/#funciones">Funciones</a>
        <a href="/#como-funciona">Cómo funciona</a>
        <a href="/#pruebalo">Demo interactiva</a>
        <a href="/#preguntas">Preguntas frecuentes</a>
        <a
          href="https://github.com/rezzt-dev"
          target="_blank"
          rel="noopener noreferrer"
        >
          Perfil del autor <span aria-hidden="true">↗</span>
          <span class="sr-only"> (se abre en otra pestaña)</span>
        </a>
      </div>
      <div>
        <h2>Información legal</h2>
        <a href="/aviso-legal/">Aviso legal</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/cookies/">Cookies</a>
      </div>
      <div>
        <h2>Contacto</h2>
        <a href="mailto:contacto@rezzt.dev">contacto@rezzt.dev</a>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>© {year} OurMeal. Todos los derechos reservados.</p>
    <p>Hecho para planificar con calma.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #151515;
    border-top: 1px solid #ffffff18;
  }
  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 1.65fr);
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: -0.025em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--color-brand);
    color: var(--color-canvas);
  }
  .footer-about p {
    max-width: 28ch;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .footer-links > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    min-width: 0;
  }
  .footer-links h2 {
    margin: 0 0 0.55rem;
    color: var(--color-ink);
    font: 700 0.95rem/1.3 var(--font-body);
  }
  .site-footer a:not(.brand) {
    color: var(--color-muted);
    text-decoration: none;
    line-height: 1.4;
    overflow-wrap: anywhere;
    transition: color 0.18s ease;
  }
  .site-footer a:hover {
    color: var(--color-ink);
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid #ffffff1c;
  }
  .footer-bottom p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  @media (max-width: 800px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer a {
      transition: none;
    }
  }
</style>
